[Unit]
Description=StockBot2 Automated Trading System
After=network.target
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=jpearce
Group=jpearce
WorkingDirectory=/home/jpearce/Documents/Python/StockBot2-Experimental
Environment=PATH=/home/jpearce/Documents/Python/StockBot2-Experimental/.venv/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
ExecStart=/home/jpearce/Documents/Python/StockBot2-Experimental/.venv/bin/python3 /home/jpearce/Documents/Python/StockBot2-Experimental/market_automation.py
Restart=always
RestartSec=30
StandardOutput=journal
StandardError=journal
SyslogIdentifier=stockbot-automation

# Resource limits
MemoryMax=8G
CPUQuota=200%

# Security settings
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=false
ReadWritePaths=/home/jpearce/Documents/Python/StockBot2-Experimental

# Environment variables
Environment=TF_CPP_MIN_LOG_LEVEL=2
Environment=TF_ENABLE_ONEDNN_OPTS=1
Environment=TF_FORCE_GPU_ALLOW_GROWTH=true

[Install]
WantedBy=multi-user.target
